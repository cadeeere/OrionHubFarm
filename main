--!strict
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
if not RunService:IsClient() then return end
local player = Players.LocalPlayer
while not player do task.wait(); player = Players.LocalPlayer end
local playerGui = player:WaitForChild("PlayerGui")
local MESH_ID = 139025296710661
local HEIGHT = 2.1
local state = {speed = 30, delay = 1.5, autoReset = true, autoPark = true, noclip = false}
local function root(): BasePart?
	local c = player.Character
	return c and (c:FindFirstChild("HumanoidRootPart") :: BasePart? or c.PrimaryPart)
end
local function humanoid(): Humanoid?
	local c = player.Character
	return c and c:FindFirstChildOfClass("Humanoid")
end
local function setFlying(on: boolean)
	local h = humanoid()
	if h then h:ChangeState(on and Enum.HumanoidStateType.Physics or Enum.HumanoidStateType.GettingUp) end
end
local function meshId(inst: Instance): number?
	local raw = (inst :: any).MeshId
	if typeof(raw) ~= "string" or raw == "" then raw = tostring((inst :: any).MeshContent) end
	local d = typeof(raw) == "string" and string.match(raw, "(%d+)") or nil
	return d and tonumber(d) or nil
end
local function isVisible(part: BasePart, mesh: Instance?): boolean
	if not part.Parent then return false end
	if not part:IsA("BasePart") then return false end
	if part.Size.Magnitude <= 0.01 then return false end
	local alpha = part.Transparency
	local localModifier = (part :: any).LocalTransparencyModifier
	if typeof(localModifier) == "number" then alpha += localModifier end
	if alpha >= 0.99 then return false end
	local pos = part.Position
	if pos.X ~= pos.X or pos.Y ~= pos.Y or pos.Z ~= pos.Z then return false end
	for _, c in ipairs(part:GetChildren()) do
		if c:IsA("Decal") or c:IsA("Texture") then
			local t = (c :: any).Transparency
			if typeof(t) == "number" and t >= 0.99 then return false end
		end
	end
	local function aVisible(inst: Instance): boolean
		return inst:IsA("BasePart")
			and not (inst :: any).Locked
			and ((inst :: any).Transparency or 0) < 0.99
	end
	local parent = part.Parent
	while parent and parent ~= workspace do
		if parent:IsA("Model") then
			local world = (parent :: any).WorldPivot
			if world.Position.Magnitude > 10000 then return false end
		end
		if parent:IsA("BasePart") and not aVisible(parent) then return false end
		parent = parent.Parent
	end
	if mesh and mesh:IsA("SpecialMesh") then
		local scale = (mesh :: any).Scale
		if typeof(scale) == "Vector3" and scale.Magnitude <= 0.01 then return false end
	end
	return true
end
local function targetOf(inst: Instance): BasePart?
	if inst:IsA("MeshPart") and meshId(inst) == MESH_ID then
		if isVisible(inst, nil) then return inst end
		return nil
	end
	if inst:IsA("SpecialMesh") and meshId(inst) == MESH_ID then
		local p = inst.Parent
		if p and p:IsA("BasePart") and isVisible(p, inst) then return p end
	end
	return nil
end
local token, flying, flights = 0, false, 0
local collide: {[BasePart]: boolean} = {}
local parked = false
local lastCoin = os.clock()
local resetDone = false
local hold: Vector3? = nil
local safe: CFrame? = nil
local waitSpot = CFrame.new(100000, 0, 100000)
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.IgnoreWater = true
local function setCollide(on: boolean)
	local c = player.Character
	if not c then table.clear(collide) return end
	if on then
		for p, old in pairs(collide) do
			if p.Parent and not p.CanCollide then p.CanCollide = old end
		end
		table.clear(collide)
		return
	end
	for _, p in ipairs(c:GetDescendants()) do
		if p:IsA("BasePart") then
			if collide[p] == nil then collide[p] = p.CanCollide end
			p.CanCollide = false
		end
	end
end
local function floorGuard()
	local r = root()
	local c = player.Character
	if not r or not c then return end
	if hold and math.abs(r.Position.Y - hold.Y) <= 1.5 then return end
	rayParams.FilterDescendantsInstances = {c}
	local hit = workspace:Raycast(r.Position + Vector3.new(0, 3, 0), Vector3.new(0, -600, 0), rayParams)
	local limit = hit and hit.Position.Y + 3 or safe and safe.Position.Y
	if limit then
		if hit then safe = CFrame.new(r.Position.X, limit, r.Position.Z) end
		if r.Position.Y < limit then
			r.AssemblyLinearVelocity = Vector3.new(r.AssemblyLinearVelocity.X, 0, r.AssemblyLinearVelocity.Z)
			r.CFrame += Vector3.new(0, limit - r.Position.Y, 0)
		end
	end
end
local function setNoclip(on: boolean)
	state.noclip = on
	if on then
		local r = root()
		safe = r and r.CFrame or nil
		setCollide(false)
		floorGuard()
		if not flying then setFlying(false) end
	else setCollide(true) end
end
local function goal(part: BasePart): Vector3
	return part.Position - Vector3.new(0, part.Size.Y * 0.5 + HEIGHT, 0)
end
local function fly(r: BasePart, to: Vector3, part: BasePart?)
	local yaw = select(2, r.CFrame:ToEulerAnglesYXZ())
	local place = function(p: Vector3)
		r.AssemblyLinearVelocity = Vector3.zero
		r.AssemblyAngularVelocity = Vector3.zero
		r.CFrame = CFrame.new(p) * CFrame.Angles(0, yaw, 0)
	end
	if state.speed <= 0 or (to - r.Position).Magnitude < 0.5 then
		place(to)
		hold = to
		return
	end
	token += 1
	local my = token
	local h = humanoid()
	local pos = r.Position
	flying = true
	flights += 1
	setFlying(true)
	setCollide(false)
	while my == token and r.Parent do
		if part and not isVisible(part, nil) then break end
		local dt = RunService.Heartbeat:Wait()
		local d = to - pos
		local dist = d.Magnitude
		if dist < 0.05 or state.speed * dt >= dist then
			place(to)
			hold = to
			break
		end
		pos += d.Unit * state.speed * dt
		place(pos)
		if h and h.Parent then h:ChangeState(Enum.HumanoidStateType.Physics) end
	end
	flights -= 1
	if flights <= 0 then
		flights = 0
		flying = false
		setFlying(false)
		if not state.noclip then setCollide(true) end
	end
end
local targets: {BasePart} = {}
local set: {[BasePart]: boolean} = {}
local sorted: {BasePart} = {}
local dirty, current, index = true, nil :: BasePart?, 0
local auto = false
local add = function(p: BasePart)
	if set[p] then return false end
	set[p] = true
	targets[#targets + 1] = p
	return true
end
local remove = function(p: BasePart)
	if not set[p] then return false end
	set[p] = nil
	for i = #targets, 1, -1 do
		if targets[i] == p then table.remove(targets, i) break end
	end
	return true
end
local function scan()
	table.clear(set)
	table.clear(targets)
	for _, i in ipairs(workspace:GetDescendants()) do
		local p = targetOf(i)
		if p then add(p) end
	end
	dirty = true
end
local function refresh()
	dirty = false
	table.clear(sorted)
	for i = 1, #targets do sorted[i] = targets[i] end
	local r = root()
	local o = r and r.Position or Vector3.zero
	table.sort(sorted, function(a, b) return (a.Position - o).Magnitude < (b.Position - o).Magnitude end)
	if not current or not set[current] then current, index = nil, 0 end
end
local goToIndex: (number) -> () = function(n)
	if n < 1 or n > #sorted then return end
	local p = sorted[n]
	if not p or not p.Parent or not isVisible(p, nil) then dirty = true return end
	current, index = p, n
	local r = root()
	if r then task.spawn(function()
		fly(r, goal(p), p)
		if current == p then
			for i = 1, #sorted do
				if sorted[i] == p then index = i break end
			end
		end
	end) end
end
local function nearest()
	if #sorted == 0 then return end
	local r = root()
	local o = r and r.Position or Vector3.zero
	local best, bestDist = nil, math.huge
	for i = 1, #sorted do
		local p = sorted[i]
		if p.Parent and isVisible(p, nil) then
			local d = (p.Position - o).Magnitude
			if d < bestDist then best, bestDist = i, d end
		end
	end
	if best then goToIndex(best) end
end
workspace.DescendantAdded:Connect(function(i)
	local p = targetOf(i)
	if p and add(p) then dirty = true end
end)
workspace.DescendantRemoving:Connect(function(i)
	local p = targetOf(i)
	if p and remove(p) then dirty = true end
end)
local gui = Instance.new("ScreenGui")
gui.Name = "MeshTeleportGui"
gui.ResetOnSpawn = false
gui.DisplayOrder = 100
gui.Parent = playerGui
local function corner(parent: Instance, r: UDim)
	local c = Instance.new("UICorner")
	c.CornerRadius = r
	c.Parent = parent
	return c
end
local function label(parent: Instance, text: string, x: number, y: number, w: number, size: number, font: Enum.Font?)
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Size = UDim2.fromOffset(w, 22)
	l.Position = UDim2.fromOffset(x, y)
	l.Text = text
	l.TextColor3 = Color3.new(1, 1, 1)
	l.Font = font or Enum.Font.GothamBold
	l.TextSize = size
	l.TextXAlignment = Enum.TextXAlignment.Left
	l.Parent = parent
	return l
end
