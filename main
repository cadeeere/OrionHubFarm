fill.BackgroundColor3 = Color3.fromRGB(90, 165, 255)
fill.BorderSizePixel = 0
fill.Parent = slider
corner(fill, UDim.new(1, 0))
label(panel, "Auto reset", 16, 118, 100, 15)
label(panel, "Auto TP", 16, 146, 100, 15)
local resetTrack = Instance.new("TextButton")
resetTrack.Size = UDim2.fromOffset(48, 24)
resetTrack.Position = UDim2.fromOffset(150, 116)
resetTrack.BackgroundColor3 = Color3.fromRGB(90, 165, 255)
resetTrack.Text = ""
resetTrack.BorderSizePixel = 0
resetTrack.AutoButtonColor = false
resetTrack.Parent = panel
