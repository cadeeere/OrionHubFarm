label(panel, "speed", 16, 62, 70, 15)
local box = Instance.new("TextBox")
box.Size = UDim2.fromOffset(68, 24)
box.Position = UDim2.fromOffset(150, 60)
box.BackgroundColor3 = Color3.new(1, 1, 1)
box.PlaceholderText = "0-600"
box.TextColor3 = Color3.fromRGB(25, 28, 32)
box.Font = Enum.Font.GothamBold
box.TextSize = 14
box.ClearTextOnFocus = false
box.Text = "30"
box.Parent = panel
corner(box, UDim.new(0, 6))
local slider = Instance.new("TextButton")
slider.Size = UDim2.fromOffset(218, 14)
slider.Position = UDim2.fromOffset(16, 94)
