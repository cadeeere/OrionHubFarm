local resetKnob = Instance.new("Frame")
resetKnob.Size = UDim2.fromOffset(20, 20)
resetKnob.Position = UDim2.fromOffset(26, 2)
resetKnob.BackgroundColor3 = Color3.new(1, 1, 1)
resetKnob.BorderSizePixel = 0
resetKnob.Parent = resetTrack
corner(resetKnob, UDim.new(1, 0))
local parkTrack = Instance.new("TextButton")
parkTrack.Size = UDim2.fromOffset(48, 24)
parkTrack.Position = UDim2.fromOffset(150, 144)
parkTrack.BackgroundColor3 = Color3.fromRGB(90, 165, 255)
parkTrack.Text = ""
parkTrack.BorderSizePixel = 0
parkTrack.AutoButtonColor = false
parkTrack.Parent = panel
corner(parkTrack, UDim.new(1, 0))
local parkKnob = Instance.new("Frame")
parkKnob.Size = UDim2.fromOffset(20, 20)
parkKnob.Position = UDim2.fromOffset(26, 2)
parkKnob.BackgroundColor3 = Color3.new(1, 1, 1)
parkKnob.BorderSizePixel = 0
parkKnob.Parent = parkTrack
corner(parkKnob, UDim.new(1, 0))
local setParkToggle = function()
	if state.autoPark then
		parkKnob.Position = UDim2.fromOffset(26, 2)
		parkKnob.BackgroundColor3 = Color3.new(1, 1, 1)
		parkTrack.BackgroundColor3 = Color3.fromRGB(90, 165, 255)
	else
		parkKnob.Position = UDim2.fromOffset(2, 2)
		parkKnob.BackgroundColor3 = Color3.fromRGB(205, 208, 214)
		parkTrack.BackgroundColor3 = Color3.new(1, 1, 1)
	end
end
parkTrack.MouseButton1Click:Connect(function()
	state.autoPark = not state.autoPark
	setParkToggle()
end)
panel.Size = UDim2.fromOffset(250, 200)
local credit = label(panel, "made by Orionhub", 0, 178, 250, 10, Enum.Font.Gotham)
credit.TextXAlignment = Enum.TextXAlignment.Center
local setSpeed = function(v: number)
	state.speed = math.clamp(math.floor(v + 0.5), 0, 600)
	box.Text = tostring(state.speed)
	fill.Size = UDim2.fromScale(state.speed / 600, 1)
end
local setResetToggle = function()
	if state.autoReset then
		resetKnob.Position = UDim2.fromOffset(26, 2)
		resetKnob.BackgroundColor3 = Color3.new(1, 1, 1)
		resetTrack.BackgroundColor3 = Color3.fromRGB(90, 165, 255)
	else
		resetKnob.Position = UDim2.fromOffset(2, 2)
		resetKnob.BackgroundColor3 = Color3.fromRGB(205, 208, 214)
		resetTrack.BackgroundColor3 = Color3.new(1, 1, 1)
	end
end
local setToggle = function()
	if auto then
		knob.Position = UDim2.fromOffset(26, 2)
		knob.BackgroundColor3 = Color3.new(1, 1, 1)
		track.BackgroundColor3 = Color3.fromRGB(90, 165, 255)
	else
		knob.Position = UDim2.fromOffset(2, 2)
		knob.BackgroundColor3 = Color3.fromRGB(205, 208, 214)
		track.BackgroundColor3 = Color3.new(1, 1, 1)
	end
end
local drag = false
local function slide(input: InputObject)
	local w = math.max(slider.AbsoluteSize.X, 1)
	setSpeed(math.clamp((input.Position.X - slider.AbsolutePosition.X) / w, 0, 1) * 600)
end
slider.InputBegan:Connect(function(i)
	if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
		drag = true
		slide(i)
	end
end)
slider.InputEnded:Connect(function(i)
	if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then drag = false end
end)
UserInputService.InputChanged:Connect(function(i)
	if drag and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then slide(i) end
end)
box.FocusLost:Connect(function(enter)
	setSpeed(tonumber(box.Text) or state.speed)
	if enter then box:ReleaseFocus() end
end)
resetTrack.MouseButton1Click:Connect(function()
	state.autoReset = not state.autoReset
	lastCoin = os.clock()
	resetDone = false
	setResetToggle()
end)
track.MouseButton1Click:Connect(function()
	auto = not auto
	setToggle()
	if not auto then
		farm = false
		parked = false
		setFlying(false)
		return
	end
	if not state.noclip then setNoclip(true) end
	setFlying(true)
	farm = true
	task.spawn(function()
		while auto do
			if #sorted == 0 then
				if state.autoReset and not resetDone then
					resetDone = true
					local h = humanoid()
					if h then h.Health = 0 end
					task.wait(3)
				end
				if state.autoPark and not parked then
					parked = true
					local r = root()
					if r then
						hold = waitSpot.Position
						r.CFrame = waitSpot
					end
				end
				if dirty then refresh() end
				task.wait(0.1)
			else
				resetDone = false
				parked = false
				nearest()
				if current then lastCoin = os.clock() end
				if auto then task.wait(state.delay) end
			end
		end
	end)
end)
open.MouseButton1Click:Connect(function()
	panel.Visible = not panel.Visible
	if panel.Visible then
		scan()
		refresh()
	end
end)
task.spawn(function()
	while gui.Parent do
		RunService.Heartbeat:Wait()
		if (auto or farm) and not flying then
			local r = root()
			if r then
				local h = humanoid()
				if h then h:ChangeState(Enum.HumanoidStateType.Physics) end
				r.AssemblyLinearVelocity = Vector3.zero
				r.AssemblyAngularVelocity = Vector3.zero
				if hold then
					local yaw = select(2, r.CFrame:ToEulerAnglesYXZ())
					r.CFrame = CFrame.new(hold) * CFrame.Angles(0, yaw, 0)
				end
			end
		end
	end
end)
task.spawn(function()
	while gui.Parent do
		task.wait(0.5)
		if dirty then refresh() end
		if state.noclip then
			setCollide(false)
			floorGuard()
		end
	end
end)
task.spawn(function()
	while gui.Parent do
		RunService.Heartbeat:Wait()
		if state.noclip and not flying then floorGuard() end
	end
end)
player.CharacterAdded:Connect(function()
	token += 1
	flights = 0
	flying = false
	setFlying(false)
	table.clear(collide)
	safe, hold, parked, farm = nil, nil, false, false
	task.wait(0.5)
	if state.noclip then
		local r = root()
		safe = r and r.CFrame or nil
		setCollide(false)
	end
	if auto then
		if not state.noclip then setNoclip(true) end
		setFlying(true)
		farm = true
	end
	scan()
	refresh()
end)
setSpeed(state.speed)
scan()
refresh()
